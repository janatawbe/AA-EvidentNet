# Dataset — large, not versioned. Tracked instead via manifests + hashes.
data/raw/
data/processed/
data/manifests/*.json
data/manifests/*.csv
data/audit/*

!data/raw/.gitkeep
!data/processed/.gitkeep
!data/manifests/.gitkeep
!data/audit/.gitkeep

# Results — regenerated by running the pipeline, not versioned.
results/logs/*
results/checkpoints/*
results/raw_predictions/*
results/tables/*
results/figures/*
!results/**/.gitkeep

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/
.venv/
venv/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
